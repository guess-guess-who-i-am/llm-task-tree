# Shared root configuration. Put the completed `.env` beside the repository/kit installation.
# Project directories may omit their own `.env`; set TASK_TREE_GLOBAL_ENV_FILE only when the
# shared file is stored elsewhere. Never commit the completed file or its API keys.

# Knowledge base root folder. Each immediate subfolder becomes an independent library.
KNOWLEDGE_LIBRARY_ROOT=knowledge
# Legacy single-folder alias (used when libraryRoot is unset).
KNOWLEDGE_DOCS_DIR=knowledge

# OpenAI-compatible embeddings endpoint. The server calls `${BASE_URL}/embeddings`.
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_API_KEY=
# Reindex embedding throughput. Default is 64 texts per request and 40 requests in parallel.
# Lower concurrency if your embedding provider rate-limits or rejects large parallel loads.
KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
KNOWLEDGE_EMBEDDING_CONCURRENCY=40
# Independent read/download slots; immediately refilled, not a tool-round limit.
TASK_TREE_TOOL_CONCURRENCY=100

# Optional default model used by the knowledge QA panel.
KNOWLEDGE_CHAT_MODEL_ID=main

# Knowledge retrieval diversity (also in knowledge-config.json → retrieval).
# maxChunksPerDoc=1 spreads top-K across more papers; increase to 2-3 for depth on one paper.
# KNOWLEDGE_RETRIEVAL_MAX_CHUNKS_PER_DOC=1
# KNOWLEDGE_RETRIEVAL_CANDIDATE_POOL_MULTIPLIER=10
# KNOWLEDGE_RETRIEVAL_DIVERSIFY=true

# CodeLoc: open files in Cursor / VS Code from the task graph UI.
# CURSOR_CLI_PATH=D:\cursor\resources\app\bin\cursor.cmd
# CODE_CLI_PATH=D:\Microsoft VS Code\bin\code.cmd

# Web search provider: tavily, brave, exa, searxng, openwebsearch, or empty to disable.
# tavily/brave/exa require API keys.
# searxng does not require an API key, but WEB_SEARCH_BASE_URL must point to a reachable
# SearXNG instance with JSON results enabled. Public instances may rate-limit or block automation;
# a self-hosted SearXNG instance is the more reliable no-key option.
# openwebsearch does not require an API key. `打开任务图.cmd` will auto-start the
# local open-webSearch daemon when open-webSearch/build exists. First-time setup still needs:
# `cd open-webSearch && npm install && npm run build`.
WEB_SEARCH_PROVIDER=openwebsearch
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=http://127.0.0.1:3210
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
OPEN_WEBSEARCH_ENGINES=duckduckgo,bing
OPEN_WEBSEARCH_SEARCH_MODE=request

# Multi-model agents. Add or remove IDs here, then define each block below.
MODEL_AGENT_IDS=main,critic

MODEL_AGENT_MAIN_NAME=GPT 6.1 Sol
MODEL_AGENT_MAIN_BASE_URL=https://api.yujianwudi.top/v1
MODEL_AGENT_MAIN_FALLBACK_BASE_URLS=https://yujianwudi.top/v1,https://yujianwudi.net/v1
MODEL_AGENT_MAIN_MODEL=gpt-6.1-sol
# Worker model context capacity and proactive compression trigger. Compression
# begins above 200K tokens; the 270K window is the maximum configured capacity.
MODEL_AGENT_MAIN_CONTEXT_WINDOW=270000
MODEL_AGENT_MAIN_COMPACTION_THRESHOLD_TOKENS=200000
# Rejected requests may switch models; completed tools and partial streams are never replayed.
MODEL_AGENT_MAIN_FALLBACK_MODELS=
MODEL_AGENT_MAIN_HEADERS_TIMEOUT_MS=60000
# Request-only liveness limits, never total task/Hook/tool time limits.
# Any received body bytes (including reasoning/heartbeat) reset the idle budget.
MODEL_AGENT_MAIN_STREAM_IDLE_TIMEOUT_MS=120000
TASK_TREE_PLANNER_MODEL=gpt-6.1-sol
TASK_TREE_PLANNER_FALLBACK_MODELS=
MODEL_AGENT_MAIN_API_KEY=
MODEL_AGENT_MAIN_WIRE_API=chat
MODEL_AGENT_MAIN_ENABLED=true
MODEL_AGENT_MAIN_AGENT_FILE=model-agents/main.md

MODEL_AGENT_CRITIC_NAME=GPT 6.1 Sol（评审）
MODEL_AGENT_CRITIC_BASE_URL=https://yujianwudi.net/v1
MODEL_AGENT_CRITIC_MODEL=gpt-6.1-sol
MODEL_AGENT_CRITIC_API_KEY=
MODEL_AGENT_CRITIC_WIRE_API=chat
MODEL_AGENT_CRITIC_ENABLED=true
MODEL_AGENT_CRITIC_AGENT_FILE=model-agents/critic.md
