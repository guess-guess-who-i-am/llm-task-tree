{
  "name": "llm-task-tree",
  "interface": {
    "displayName": "任务图（llm-task-tree）",
    "description": "把项目的任务图变成 Agent 可直接调用的工具：在对话里直接看整张图、读焦点、按字段写树、链式推进、检索知识库、自动排版。"
  },
  "plugins": [
    {
      "name": "task-tree",
      "source": {
        "source": "local",
        "path": "./plugins/task-tree"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Productivity"
    }
  ]
}
