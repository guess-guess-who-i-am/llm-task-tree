# Local-only configuration. Copy this file to `.env` and fill values.
# `.env` is ignored by git and is read by server.js on each API call.

# Knowledge base markdown folder, relative to this project.
KNOWLEDGE_DOCS_DIR=knowledge

# OpenAI-compatible embeddings endpoint. The server calls `${BASE_URL}/embeddings`.
KNOWLEDGE_EMBEDDING_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_API_KEY=

# Optional default model used by the knowledge QA panel.
KNOWLEDGE_CHAT_MODEL_ID=main

# Web search provider: tavily, brave, exa, searxng, openwebsearch, or empty to disable.
# tavily/brave/exa require API keys.
# searxng does not require an API key, but WEB_SEARCH_BASE_URL must point to a reachable
# SearXNG instance with JSON results enabled. Public instances may rate-limit or block automation;
# a self-hosted SearXNG instance is the more reliable no-key option.
# openwebsearch does not require an API key. `打开任务图.cmd` will auto-start the
# local open-webSearch daemon when open-webSearch/build exists. First-time setup still needs:
# `cd open-webSearch && npm install && npm run build`.
WEB_SEARCH_PROVIDER=openwebsearch
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=http://127.0.0.1:3210
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
OPEN_WEBSEARCH_ENGINES=duckduckgo,bing
OPEN_WEBSEARCH_SEARCH_MODE=request

# Multi-model agents. Add or remove IDs here, then define each block below.
MODEL_AGENT_IDS=main,critic

MODEL_AGENT_MAIN_NAME=Main model
MODEL_AGENT_MAIN_BASE_URL=https://api.openai.com/v1
MODEL_AGENT_MAIN_MODEL=gpt-4.1
MODEL_AGENT_MAIN_API_KEY=
MODEL_AGENT_MAIN_WIRE_API=chat
MODEL_AGENT_MAIN_ENABLED=true
MODEL_AGENT_MAIN_AGENT_FILE=model-agents/main.md

MODEL_AGENT_CRITIC_NAME=Critic model
MODEL_AGENT_CRITIC_BASE_URL=https://api.openai.com/v1
MODEL_AGENT_CRITIC_MODEL=gpt-4.1
MODEL_AGENT_CRITIC_API_KEY=
MODEL_AGENT_CRITIC_WIRE_API=chat
MODEL_AGENT_CRITIC_ENABLED=true
MODEL_AGENT_CRITIC_AGENT_FILE=model-agents/critic.md
